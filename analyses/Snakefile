"""NCBI accession-defined references, fresh MAFFT alignments and IQ-TREE inference.

Consumes the retained Mexican marker candidates and validated Sanger sequences.
No pre-existing alignment or external repository sequence panel is consumed.
"""
from pathlib import Path
import shutil

HERE = Path(workflow.basedir).resolve()
ROOT = HERE.parent
configfile: str(HERE / "config/config.yaml")
WORK = str(ROOT / config["scratch"])
OUT = str(HERE / "results")
INPUTS = str(HERE / "inputs")
REFERENCE = str(ROOT / "references/ncbi")
PYTHON = config.get("analysis_python", "python")
IQTREE = shutil.which(config["iqtree"]) or config["iqtree"]
GENES = ["16S", "18S", "CO1", "ITS", "mitogenome_submitted"]

wildcard_constraints:
    gene = "16S|18S|CO1|ITS|mitogenome_submitted"

include: "workflow/references.smk"
include: "workflow/inference.smk"

rule all:
    input:
        expand(OUT + "/tree_reports/{gene}.json", gene=GENES),
        expand(OUT + "/genetic_groups/{gene}.pdf", gene=GENES)
    default_target: True
